// Shared SMS host-link policy: ESP32 MAC and KSZ port 3 must agree.
#pragma once
#define SMS_KSZ_HOST_CONTROL4 0x20U /* Profile H: full duplex, 100M; retain flow control */
#define SMS_KSZ_HOST_SPEED ETH_SPEED_100M
#define SMS_KSZ_HOST_DUPLEX ETH_DUPLEX_FULL
#define SMS_KSZ_HOST_SPEED_MBPS 100U
#define SMS_KSZ_IO_DRIVE_MASK 0x40U /* G0E bit6: 16 mA */
#define SMS_KSZ_RMII_INVERT_MASK 0x80U /* P36 bit7: inverted RMII clock */
#define SMS_KSZ_RMII_INVERT_VALUE 0x00U /* Profile H: original/non-inverted clock */
